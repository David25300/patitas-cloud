=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="718"/></Array></mxGeometry></mxCell><mxCell id="c31" value="⑨ telemetría" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.739;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;div style='text-align:left'&gt;&lt;b style='font-size:13px'&gt;Identidades y mínimo privilegio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style='border-collapse:collapse;font-size:10px' border='1' cellpadding='4'&gt;&lt;tr style='background:#E8F1FB'&gt;&lt;th&gt;Identidad&lt;/th&gt;&lt;th&gt;Rol&lt;/th&gt;&lt;th&gt;Alcance&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;id-patitas-github&lt;br&gt;(GitHub Actions, OIDC)&lt;/td&gt;&lt;td&gt;Contributor&lt;/td&gt;&lt;td&gt;solo rg-patitas-prod&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Identidad de la&lt;br&gt;Function App&lt;/td&gt;&lt;td&gt;Cosmos DB Built-in Data Contributor&lt;/td&gt;&lt;td&gt;cuenta de Cosmos DB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;Key Vault Secrets User&lt;/td&gt;&lt;td&gt;el vault&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;envío de correo&lt;/td&gt;&lt;td&gt;recurso de ACS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Personal&lt;br&gt;(grupo Recepción)&lt;/td&gt;&lt;td&gt;rol &lt;i&gt;recepcion&lt;/i&gt; en SWA&lt;/td&gt;&lt;td&gt;rutas /admin/*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cliente&lt;/td&gt;&lt;td&gt;anónimo&lt;/td&gt;&lt;td&gt;agendar y ver franjas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Equipo de TI&lt;/td&gt;&lt;td&gt;Owner (con MFA)&lt;/td&gt;&lt;td&gt;suscripción&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b style='font-size:12px'&gt;Secretos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;• Sin credenciales en el repositorio: GitHub guarda solo IDs.&lt;br&gt;• En producción no hay llaves: identidad administrada + RBAC.&lt;br&gt;• Key Vault solo para secretos de terceros.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E6C770;fontSize=11;align=left;verticalAlign=top;spacing=8;html=1;whiteSpace=wrap;fontColor=#4A3B00;" vertex="1" parent="1"><mxGeometry x="1320" y="70" width="380" height="530" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>