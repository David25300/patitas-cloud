<mxfile host="drawio" type="device"><diagram id="d1" name="Pipeline de despliegue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Pipeline de despliegue (GitHub Actions) · Veterinaria Patitas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:13px'&gt;1. Push / PR&lt;/b&gt;&lt;br&gt;&lt;br&gt;• push a develop o main&lt;br&gt;• pull request a develop o main&lt;br&gt;• manual (workflow_dispatch)&lt;br&gt;" style="rounded=1;arcSize=8;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="235" height="125" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:13px'&gt;2. Build&lt;/b&gt;&lt;br&gt;&lt;br&gt;• npm ci (lockfile)&lt;br&gt;• tsc: compila la API&lt;br&gt;• az bicep build: valida la IaC&lt;br&gt;" style="rounded=1;arcSize=8;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="315" y="70" width="235" height="125" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;3. Pruebas  (+5)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ESLint + verificación de tipos&lt;br&gt;• 32 pruebas unitarias (Vitest)&lt;br&gt;• &lt;b&gt;si algo falla, no hay despliegue&lt;/b&gt;&lt;br&gt;" style="rounded=1;arcSize=8;fillColor=#FFF3CD;strokeColor=#D4A017;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="235" height="125" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;4. Deploy&lt;/b&gt;&lt;br&gt;&lt;br&gt;• azure/login con OIDC&lt;br&gt;• Bicep: infraestructura idempotente&lt;br&gt;• SWA: web + API (token efímero)&lt;br&gt;" style="rounded=1;arcSize=8;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="865" y="70" width="235" height="125" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;5. Smoke test  (+3)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /api/health con el SHA nuevo&lt;br&gt;• usa Cosmos DB · lista citas&lt;br&gt;• validación 400 · HTTP → HTTPS&lt;br&gt;" style="rounded=1;arcSize=8;fillColor=#FFF3CD;strokeColor=#D4A017;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1140" y="70" width="235" height="125" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;Resultado&lt;/b&gt;&lt;br&gt;&lt;br&gt;• verde: ambiente actualizado&lt;br&gt;• rojo: el job falla y GitHub notifica&lt;br&gt;• rollback manual (abajo)&lt;br&gt;" style="rounded=1;arcSize=8;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1415" y="70" width="235" height="125" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;En paralelo  (+2)&lt;/b&gt; · Checkov analiza el Bicep · CodeQL analiza el TypeScript · Dependabot actualiza dependencias" style="rounded=1;arcSize=8;fillColor=#FFF3CD;strokeColor=#D4A017;strokeWidth=1.5;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="315" y="215" width="510" height="46" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ramas y ambientes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="24" as="geometry"/></mxCell><mxCell id="c16" value="feature/*" style="rounded=1;arcSize=50;fillColor=#24292F;strokeColor=#24292F;fontColor=#FFFFFF;fontSize=12;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="150" height="44" as="geometry"/></mxCell><mxCell id="c17" value="develop" style="rounded=1;arcSize=50;fillColor=#24292F;strokeColor=#24292F;fontColor=#FFFFFF;fontSize=12;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="150" height="44" as="geometry"/></mxCell><mxCell id="c18" value="main" style="rounded=1;arcSize=50;fillColor=#24292F;strokeColor=#24292F;fontColor=#FFFFFF;fontSize=12;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="150" height="44" as="geometry"/></mxCell><mxCell id="c19" value="pull request&lt;br&gt;(CI sin despliegue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="pull request + merge&lt;br&gt;= promoción a producción" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Ambiente dev&lt;/b&gt; · GitHub environment &lt;i&gt;dev&lt;/i&gt;&lt;br&gt;swa-patitas-dev · base de datos patitas-dev&lt;br&gt;despliegue automático en cada push a develop" style="rounded=1;arcSize=8;fillColor=#EEF8F1;strokeColor=#1E8449;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="310" height="70" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Ambiente prod&lt;/b&gt; · GitHub environment &lt;i&gt;prod&lt;/i&gt;&lt;br&gt;swa-patitas-prod · base de datos patitas-prod&lt;br&gt;despliegue en cada merge a main (aprobación opcional)" style="rounded=1;arcSize=8;fillColor=#EEF8F1;strokeColor=#1E8449;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="310" height="70" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5A6B7B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px'&gt;Secretos&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;OIDC:&lt;/b&gt; azure/login pide a Entra ID un token de corta duración; la federated credential solo acepta los environments dev y prod de este repositorio.&lt;br&gt;• &lt;b&gt;GitHub Secrets:&lt;/b&gt; solo AZURE_CLIENT_ID, AZURE_TENANT_ID y AZURE_SUBSCRIPTION_ID (identificadores).&lt;br&gt;• &lt;b&gt;Llaves:&lt;/b&gt; el token de SWA se pide en cada ejecución y se enmascara. En el MVP, Bicep inyecta la llave de Cosmos en los app settings; en producción se reemplaza por identidad administrada." style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="520" height="170" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style='font-size:13px'&gt;Promoción de cambios&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Se trabaja en feature/* y se integra a develop con pull request.&lt;br&gt;• develop se despliega solo en dev y se prueba ahí.&lt;br&gt;• El pull request develop → main es la promoción: al hacer merge se despliega el mismo código en prod.&lt;br&gt;• El mismo Bicep crea los dos ambientes, con parámetros distintos (main.dev / main.prod)." style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="530" width="520" height="170" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style='font-size:13px'&gt;Rollback&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Rápido:&lt;/b&gt; workflow &lt;i&gt;Rollback&lt;/i&gt; (manual): se elige el ambiente y el SHA que funcionaba; vuelve a desplegar esa versión y corre el smoke test.&lt;br&gt;• &lt;b&gt;Por código:&lt;/b&gt; git revert del commit en main → el pipeline despliega la corrección.&lt;br&gt;• &lt;b&gt;Datos:&lt;/b&gt; Cosmos DB restaura a un punto en el tiempo de los últimos 7 días." style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontSize=11;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1140" y="530" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>